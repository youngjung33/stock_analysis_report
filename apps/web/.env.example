# Supabase PostgreSQL (Dashboard → Project Settings → Database → Connection string)
# Project: stock_analysis_report_db (ap-northeast-1, ref: zpdmtgfuhavtzjcehxll)
#
# Pooler username MUST be postgres.[PROJECT-REF] (not plain "postgres").
# Password special chars (@ # etc.) must be URL-encoded in the connection string.
#
# App / serverless (Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.zpdmtgfuhavtzjcehxll:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Prisma migrate deploy uses DIRECT_URL (Session pooler 5432 — same host as above)
DIRECT_URL="postgresql://postgres.zpdmtgfuhavtzjcehxll:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
#
# If P1001 persists on 5432, try direct host instead (IPv6/firewall issues on some networks):
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.zpdmtgfuhavtzjcehxll.supabase.co:5432/postgres"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Guest session cookie signing (optional — defaults to JWT_ACCESS_SECRET)
# GUEST_SESSION_SECRET=

# Production rate limiting (required on Vercel — shared across serverless instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SEED_USERNAME=admin
SEED_PASSWORD=admin1234

# US portfolio quote refresh (optional)
FINNHUB_API_KEY=your-finnhub-api-key

# KR DART Open API (optional — Phase L disclosure + Phase M corp_code fetch)
# DART_API_KEY=

# Vercel cron — recommendation ledger batch/outcomes (production)
# CRON_SECRET=

# Email (optional — omit for dev console sender)
# RESEND_API_KEY=
# EMAIL_FROM="SAR Portfolio <onboarding@resend.dev>"

# OAuth (optional — omit provider vars to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Observability (optional)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# App URL for email links / metadata (production)
# APP_URL=https://your-domain.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Client API base (default: same-origin /api)
# NEXT_PUBLIC_API_BASE_URL=/api

# E2E member login — defaults to SEED_USERNAME/SEED_PASSWORD when DATABASE_URL is set
# E2E_USERNAME=
# E2E_PASSWORD=
