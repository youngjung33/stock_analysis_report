# Supabase PostgreSQL (Settings → Database → Connection string)
# Transaction pooler (Vercel/serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Prisma migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Guest session cookie signing (optional — defaults to JWT_ACCESS_SECRET)
# GUEST_SESSION_SECRET=

# Production rate limiting (recommended on Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

SEED_USERNAME=admin
SEED_PASSWORD=admin1234

# US portfolio quote refresh (optional)
FINNHUB_API_KEY=your-finnhub-api-key

# Email (optional — omit for dev console sender)
# RESEND_API_KEY=
# EMAIL_FROM="SAR Portfolio <onboarding@resend.dev>"

# OAuth (optional — omit provider vars to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Observability (optional)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# App URL for email links / metadata (production)
# APP_URL=https://your-domain.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Client API base (default: same-origin /api)
# NEXT_PUBLIC_API_BASE_URL=/api

# E2E member login (local/CI only)
# E2E_USERNAME=
# E2E_PASSWORD=
