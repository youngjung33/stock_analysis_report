{
  "name": "stock-analysis-report",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sar/web",
    "build": "npm run build -w @sar/shared && npm run build -w @sar/web",
    "start": "npm run start -w @sar/web",
    "test": "npm run test -w @sar/shared && npm run test -w @sar/web",
    "test:e2e": "npm run test:e2e -w @sar/web",
    "test:e2e:production": "npm run build && npm run test:e2e:production -w @sar/web",
    "lint": "npm run lint -w @sar/web",
    "db:migrate": "npm run db:migrate -w @sar/web",
    "db:deploy": "npm run db:deploy -w @sar/web",
    "db:push": "npm run db:push -w @sar/web",
    "db:seed": "npm run db:seed -w @sar/web",
    "fetch:stocks": "npm run fetch:stocks -w @sar/web",
    "db:import-stocks": "npm run db:import-stocks -w @sar/web"
  },
  "devDependencies": {
    "brace-expansion": "5.0.9",
    "prettier": "^3.5.3"
  },
  "overrides": {
    "axios": "^1.20.0",
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "next": {
      "postcss": "8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "minimatch": {
      "brace-expansion": "$brace-expansion"
    }
  }
}
